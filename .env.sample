# App Identity
VITE_APP_NAME=Font Finder
VITE_APP_VERSION=v0.2.4
VITE_GITHUB_REPO_URL=https://github.com/monodle/fontfinder

# Library Defaults (all, user, system, activated, favorites, duplicates)
VITE_DEFAULT_CATEGORY=user

# Font Preview Defaults
VITE_DEFAULT_FONT_SIZE=24
VITE_MIN_FONT_SIZE=14
VITE_MAX_FONT_SIZE=72
VITE_DEFAULT_VIEW_MODE=grid
VITE_DEFAULT_GRID_COLUMNS=3

# Variable Font Defaults
VITE_DEFAULT_VARIABLE_WEIGHT=400

# Performance & Virtual Scroll
VITE_VIRTUAL_SCROLL_OVERSCAN=5
VITE_MAX_GLYPH_PREVIEW_COUNT=300

# UI Timing
VITE_TOAST_DURATION_MS=2500
